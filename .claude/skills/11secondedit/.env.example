# Copy to .env (in this folder or your project root). Never commit .env.

# Audio enhancement (https://auphonic.com/accounts/settings/#api-key)
AUPHONIC_API_KEY=

# Background music + sound effects (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# WhisperX (pip install whisperx). Bigger model = better timestamps, slower.
WHISPERX_BIN=whisperx
WHISPERX_MODEL=small
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_LANGUAGE=en

# Local server port
PORT=4111
